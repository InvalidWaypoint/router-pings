{
    "luci-app-healthchecks": {
        "description": "Grant access to healthchecks UCI config and service control",
        "read": {
            "uci": [ "healthchecks" ]
        },
        "write": {
            "uci": [ "healthchecks" ],
            "file": {
                "/etc/init.d/healthchecks restart": [ "exec" ]
            }
        }
    }
}
